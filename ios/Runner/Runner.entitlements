<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Liens partagés : iOS ne remet le lien à l'application que si ce
	     domaine sert apple-app-site-association sous /.well-known/. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:asso-dashboard.sbs</string>
	</array>
</dict>
</plist>
